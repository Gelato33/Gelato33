# Copia este archivo como .env.local y completa los valores de tu proyecto Supabase
# (Supabase > Project Settings > API). Sin estas dos variables la app arranca en modo demo.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica

# Personalización por institución (opcional)
VITE_APP_NAME=Pre PAES
VITE_BRAND_COLOR=#5b3df5
VITE_MAX_ESTUDIANTES=150
